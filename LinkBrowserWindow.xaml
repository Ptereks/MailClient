<ui:FluentWindow x:Class="ZennoVibe.MailClient.LinkBrowserWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Link"
        Width="1040"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource CarbonBackground}">

    <Grid Background="{StaticResource CarbonBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="LinkTitleBar"
                     Grid.Row="0"
                     Title="Link"
                     ShowHelp="False"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <local:CaptionButtons ShowMaximize="True" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="BackButton"
                       Grid.Column="0"
                       Style="{StaticResource IconToolButton}"
                       Margin="0,0,6,0"
                       IsEnabled="False"
                       ToolTip="Back"
                       Click="Back_Click">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" />
            </ui:Button>
            <ui:Button x:Name="ReloadButton"
                       Grid.Column="1"
                       Style="{StaticResource IconToolButton}"
                       Margin="0,0,8,0"
                       ToolTip="Reload"
                       Click="Reload_Click">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
            </ui:Button>
            <TextBox x:Name="AddressTextBox"
                     Grid.Column="2"
                     Style="{StaticResource ComposeLineTextBox}"
                     IsReadOnly="True"
                     ToolTip="Current address (read-only). Select and copy, or use the Copy button." />
            <ui:Button Grid.Column="3"
                       Style="{StaticResource IconToolButton}"
                       Margin="8,0,0,0"
                       ToolTip="Copy address"
                       Click="CopyAddress_Click">
                <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
            </ui:Button>
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0,16,8"
                CornerRadius="10"
                Background="#FFFFFFFF"
                BorderBrush="{StaticResource CarbonBorder}"
                BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="LinkWebView" />
                <TextBlock x:Name="ErrorTextBlock"
                           Visibility="Collapsed"
                           Margin="24"
                           TextWrapping="Wrap"
                           Foreground="#FF1A1A1A"
                           FontSize="13" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Height="32"
                Padding="16,0"
                Background="{StaticResource CarbonPanel}"
                BorderBrush="{StaticResource CarbonBorder}"
                BorderThickness="0,1,0,0">
            <Grid Height="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProxyTextBlock"
                           Grid.Column="0"
                           Style="{StaticResource StatusBarLabel}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           Style="{StaticResource StatusBarLabel}"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
