<ui:FluentWindow x:Class="ZennoVibe.MailClient.ReplyWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        Title="Reply"
        Width="780"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource CarbonBackground}">

    <Grid Background="{StaticResource CarbonBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ReplyTitleBar"
                     Grid.Row="0"
                     Title="Reply"
                     ShowHelp="False"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <local:CaptionButtons />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource IconToolButton}"
                           ToolTip="Copy this email address"
                           Click="CopyFrom_Click">
                    <ui:SymbolIcon Symbol="Copy24"
                                   FontSize="14"
                                   Foreground="#FFFFFF" />
                </ui:Button>
                <TextBlock x:Name="FromTextBlock"
                           Foreground="{StaticResource CarbonMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="To"
                           Margin="2,0,0,4"
                           Foreground="{StaticResource CarbonMuted}"
                           FontSize="12" />
                <TextBox x:Name="ToTextBox"
                         Height="40"
                         MinHeight="40"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         ToolTip="One or more recipients separated by commas or semicolons">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="ToBorder"
                                    Background="{StaticResource CarbonSurface}"
                                    BorderBrush="{StaticResource CarbonBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ToBorder" Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
                                    <Setter TargetName="ToBorder" Property="Background" Value="{StaticResource CarbonPanel}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <TextBlock Text="Subject"
                           Margin="2,8,0,4"
                           Foreground="{StaticResource CarbonMuted}"
                           FontSize="12" />
                <TextBox x:Name="SubjectTextBox"
                         Height="40"
                         MinHeight="40"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Message subject">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="SubjectBorder"
                                    Background="{StaticResource CarbonSurface}"
                                    BorderBrush="{StaticResource CarbonBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="SubjectBorder" Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
                                    <Setter TargetName="SubjectBorder" Property="Background" Value="{StaticResource CarbonPanel}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <Border x:Name="QuoteHost"
                        DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Background="{StaticResource CarbonSurface}"
                        BorderBrush="{StaticResource CarbonBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel>
                        <ui:Button x:Name="QuoteToggleButton"
                                   DockPanel.Dock="Top"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Style="{StaticResource ActionButton}"
                                   Content="Original message"
                                   Click="QuoteToggle_Click" />
                        <TextBox x:Name="QuoteTextBox"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 MaxHeight="160"
                                 Margin="10,0,10,10"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 IsTabStop="False" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="BodyTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="12,10"
                         ToolTip="Your reply" />
            </DockPanel>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <ui:Button x:Name="SendButton"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Top"
                           Content="Send"
                           Style="{StaticResource PrimaryActionButton}"
                           Padding="16,6"
                           Click="Send_Click" />
                <local:AttachmentPicker x:Name="Attachments"
                                        DockPanel.Dock="Left"
                                        Margin="8,0,0,0"
                                        MaxWidth="420" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource CarbonMuted}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
