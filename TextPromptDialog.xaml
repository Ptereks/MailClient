<ui:FluentWindow x:Class="ZennoVibe.MailClient.TextPromptDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        Width="520"
        Height="260"
        MinWidth="520"
        MinHeight="260"
        MaxWidth="520"
        MaxHeight="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource CarbonBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowHelp="False"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <local:CaptionButtons />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Style="{StaticResource GlassCard}"
                Margin="16,12"
                Padding="16">
            <StackPanel>
                <TextBlock x:Name="PromptTextBlock"
                           Foreground="{StaticResource CarbonMuted}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <TextBox x:Name="ValueTextBox"
                         Height="42"
                         Padding="12,0"
                         FontSize="14"
                         VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,0,16,16">
            <ui:Button Content="Cancel"
                       Style="{StaticResource ActionButton}"
                       Margin="0,0,8,0"
                       Click="Cancel_Click" />
            <ui:Button Content="Apply"
                       Style="{StaticResource PrimaryActionButton}"
                       Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
