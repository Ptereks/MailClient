<ui:FluentWindow x:Class="ZennoVibe.MailClient.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        Title="Activate Mail Client"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource CarbonBackground}">

    <DockPanel Background="{StaticResource CarbonBackground}" LastChildFill="True">
        <ui:TitleBar DockPanel.Dock="Top"
                     Title="Activate Mail Client"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Margin="20"
                Padding="20,16"
                CornerRadius="12"
                Background="{StaticResource CarbonGlassCard}"
                BorderBrush="{StaticResource CarbonGlassCardBorder}"
                BorderThickness="1"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="This copy is not activated"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CarbonText}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Send the Machine ID below to the owner and paste the activation code you get back. The code works only on this computer."
                           FontSize="12"
                           Foreground="{StaticResource CarbonMuted}"
                           Margin="0,6,0,14"
                           TextWrapping="Wrap" />

                <TextBlock Text="Machine ID"
                           FontSize="11"
                           Foreground="{StaticResource CarbonMuted}"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MachineIdBox"
                             Grid.Column="0"
                             Height="30"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             FontFamily="{StaticResource JetBrainsMono}"
                             Background="{StaticResource CarbonSurface}"
                             Foreground="{StaticResource CarbonText}"
                             BorderBrush="{StaticResource CarbonBorder}"
                             BorderThickness="1" />
                    <ui:Button Grid.Column="1"
                               Content="Copy"
                               Style="{StaticResource ActionButton}"
                               Margin="8,0,0,0"
                               Click="CopyMachineId_Click" />
                </Grid>

                <TextBlock Text="Activation code"
                           FontSize="11"
                           Foreground="{StaticResource CarbonMuted}"
                           Margin="0,0,0,4" />
                <TextBox x:Name="CodeBox"
                         MinHeight="30"
                         MaxHeight="90"
                         Padding="8,4"
                         VerticalContentAlignment="Center"
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         FontFamily="{StaticResource JetBrainsMono}"
                         Background="{StaticResource CarbonSurface}"
                         Foreground="{StaticResource CarbonText}"
                         BorderBrush="{StaticResource CarbonBorder}"
                         BorderThickness="1" />

                <TextBlock x:Name="ErrorTextBlock"
                           FontSize="12"
                           Foreground="#FFFF5C5C"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="1"
                               Content="Exit"
                               Style="{StaticResource ActionButton}"
                               Margin="0,0,8,0"
                               Click="Exit_Click" />
                    <ui:Button Grid.Column="2"
                               Content="Activate"
                               Style="{StaticResource PrimaryActionButton}"
                               Click="Activate_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </DockPanel>
</ui:FluentWindow>
