<ui:FluentWindow x:Class="ZennoVibe.MailClient.DeleteAccountGroupDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        Title="Delete account group"
        Width="520"
        Height="280"
        MinWidth="520"
        MinHeight="280"
        MaxWidth="520"
        MaxHeight="280"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource CarbonBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Delete account group"
                     Grid.Row="0"
                     ShowHelp="False"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <local:CaptionButtons />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Style="{StaticResource GlassCard}"
                Margin="16,10"
                Padding="18">
            <StackPanel>
                <TextBlock x:Name="QuestionTextBlock"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CarbonText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <TextBlock Text="Choose whether the accounts inside this group should also be deleted."
                           Foreground="{StaticResource CarbonMuted}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Keeping them moves every account to Ungrouped."
                           Foreground="{StaticResource CarbonSubtle}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,0,16,16">
            <ui:Button Content="Cancel"
                       Style="{StaticResource ActionButton}"
                       Margin="0,0,8,0"
                       Click="Cancel_Click" />
            <ui:Button Content="Keep accounts"
                       Style="{StaticResource ActionButton}"
                       Margin="0,0,8,0"
                       Click="KeepAccounts_Click" />
            <ui:Button Content="Delete with accounts"
                       Style="{StaticResource PrimaryActionButton}"
                       Click="DeleteWithAccounts_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
