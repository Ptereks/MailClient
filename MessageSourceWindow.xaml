<ui:FluentWindow x:Class="ZennoVibe.MailClient.MessageSourceWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ZennoVibe.MailClient"
        Title="Message source"
        Width="860"
        Height="640"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Icon="/Assets/AppIcon.ico"
        Background="{StaticResource CarbonBackground}">

    <Grid Background="{StaticResource CarbonBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SourceTitleBar"
                     Grid.Row="0"
                     Title="Message source"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False">
            <ui:TitleBar.TrailingContent>
                <local:CaptionButtons ShowMaximize="True" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <TextBox x:Name="SourceTextBox"
                 Grid.Row="1"
                 Margin="16"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12" />
    </Grid>
</ui:FluentWindow>
