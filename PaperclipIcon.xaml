<UserControl x:Class="ZennoVibe.MailClient.PaperclipIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="13"
             Height="13"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Foreground="{StaticResource CarbonMuted}">
    <!--
        Classic tilted paperclip: one thin stroke, round caps. Replaces the emoji 📎
        which rendered as a heavy blob in the message list.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path Fill="Transparent"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.7"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M21.44,11.05 L12.25,20.24 A6,6,0,0,1,3.76,11.75 L12.95,2.56 A4,4,0,0,1,18.61,8.22 L9.41,17.41 A2,2,0,0,1,6.58,14.58 L15.07,6.1" />
        </Canvas>
    </Viewbox>
</UserControl>
