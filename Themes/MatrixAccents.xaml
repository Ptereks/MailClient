<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Status-only Matrix accent. Do not use on headings, buttons or chrome. -->
    <Color x:Key="MatrixOkColor">#FF00FF41</Color>
    <SolidColorBrush x:Key="MatrixOk" Color="{StaticResource MatrixOkColor}" />
    <SolidColorBrush x:Key="MatrixOkFill" Color="#2200FF41" />
    <SolidColorBrush x:Key="MatrixError" Color="#FFE05252" />
    <SolidColorBrush x:Key="MatrixErrorFill" Color="#22E05252" />

    <SolidColorBrush x:Key="CarbonGlassFill" Color="#B31E1E1E" />
    <SolidColorBrush x:Key="CarbonGlassHairline" Color="#33FFFFFF" />

    <BlurEffect x:Key="GlassBlur" Radius="24" KernelType="Gaussian" />

    <FontFamily x:Key="JetBrainsMono">pack://siteoforigin:,,,/data/runtime/#JetBrains Mono</FontFamily>

    <Style x:Key="MetaMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource CarbonSubtle}" />
    </Style>

    <Style x:Key="StatusMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CarbonMuted}" />
    </Style>

    <Style x:Key="StatusBarLabel" TargetType="TextBlock" BasedOn="{StaticResource StatusMonoText}">
        <Setter Property="Height" Value="16" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
