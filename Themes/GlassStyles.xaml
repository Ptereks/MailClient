<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="MaterialElevation1" TargetType="Border">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="12"
                                  ShadowDepth="1"
                                  Opacity="0.28"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToolButton" TargetType="ui:Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHoverStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToolButtonLarge" TargetType="ui:Button" BasedOn="{StaticResource IconToolButton}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="AccountRowSyncButton" TargetType="ui:Button" BasedOn="{StaticResource IconToolButton}">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="ActionButton" TargetType="ui:Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Background" Value="{StaticResource CarbonPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHoverStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionButton" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource CarbonGreen}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CarbonGreenBright}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FluentColumn" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="FluentSidebarColumn" TargetType="Border" BasedOn="{StaticResource FluentColumn}">
        <Setter Property="Background" Value="{StaticResource CarbonGlassCard}" />
    </Style>

    <Style x:Key="FluentDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource CarbonDivider}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="RowSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CarbonDivider}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A thin line that is always visible; the whole 10px column is the drag target. -->
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTip" Value="Drag to resize" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="SplitterLine"
                                Width="2"
                                Margin="0,8"
                                HorizontalAlignment="Center"
                                CornerRadius="1"
                                Background="{StaticResource CarbonBorder}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SplitterLine" Property="Background" Value="{StaticResource CarbonAccent}" />
                            <Setter TargetName="SplitterLine" Property="Width" Value="3" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="SplitterLine" Property="Background" Value="{StaticResource CarbonGreenBright}" />
                            <Setter TargetName="SplitterLine" Property="Width" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CarbonGlassCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonGlassCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.32"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentSection" TargetType="Border" BasedOn="{StaticResource GlassCard}" />

    <Style x:Key="FluentStatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MaterialStatusBar}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="SyncProgressHost" TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource CarbonPanel}" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="SyncProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="MaxHeight" Value="6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF00FF41" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" Height="6" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Rectangle x:Name="PART_Track" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                            <Border Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Both controls need a full template: the default ones paint a light system
        background and an icon gutter that ignore Background/Foreground setters.
    -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource CarbonPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CarbonSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Applied implicitly so any menu added later is dark without extra wiring. -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}" />

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource CarbonSubtle}" />
        <Setter Property="Margin" Value="4,0,4,10" />
    </Style>

    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{StaticResource CarbonSurface}" />
        <Setter Property="Foreground" Value="{StaticResource CarbonMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonDivider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper"
                               Width="8"
                               HorizontalAlignment="Right"
                               Cursor="SizeWE"
                               Background="Transparent"
                               Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CarbonGreenFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CarbonGreenFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource CarbonSurface}" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CaretBrush" Value="{StaticResource CarbonGreenBright}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CarbonMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource CarbonPanel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        BasedOn is required: an explicitly applied keyed style replaces the implicit
        TextBox style instead of extending it, which would leave the box with the white
        system template. It must therefore be declared after that implicit style.
    -->
    <Style x:Key="SidebarFilterTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ToolTip" Value="Type to filter" />
    </Style>

    <!-- Single-line field with the caret centred; the implicit template turns Padding into a
         ScrollViewer margin, which clips text at short heights. -->
    <Style x:Key="ComposeLineTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="CaretBrush" Value="{StaticResource CarbonGreenBright}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="LineBorder"
                            Background="{StaticResource CarbonSurface}"
                            BorderBrush="{StaticResource CarbonBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="12,0"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LineBorder" Property="BorderBrush" Value="{StaticResource CarbonMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LineBorder" Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
                            <Setter TargetName="LineBorder" Property="Background" Value="{StaticResource CarbonPanel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="FormatTagChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CarbonPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="FormatDropZone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CarbonSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="SettingsBarButton" TargetType="ui:Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource CarbonPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource CarbonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource CarbonText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource CarbonGreenBright}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CarbonHoverStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
