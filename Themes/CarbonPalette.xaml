<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 dark surfaces — slightly lifted tones -->
    <SolidColorBrush x:Key="CarbonBackground" Color="#FF161616" />
    <SolidColorBrush x:Key="CarbonMicaFallback" Color="#FF161616" />

    <SolidColorBrush x:Key="CarbonSidebar" Color="#FF242424" />
    <SolidColorBrush x:Key="CarbonPanel" Color="#FF323232" />
    <SolidColorBrush x:Key="CarbonSurface" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="CarbonElevated" Color="#FF3E3E3E" />
    <SolidColorBrush x:Key="CarbonHover" Color="#FF444444" />
    <SolidColorBrush x:Key="CarbonHoverStrong" Color="#FF4E4E4E" />
    <SolidColorBrush x:Key="CarbonBorder" Color="#FF5A565E" />
    <SolidColorBrush x:Key="CarbonDivider" Color="#FF3A3A3A" />

    <SolidColorBrush x:Key="CarbonGreen" Color="#FF1F5E46" />
    <SolidColorBrush x:Key="CarbonGreenBright" Color="#FF2D7A5A" />
    <SolidColorBrush x:Key="CarbonGreenFill" Color="#662D7A5A" />

    <SolidColorBrush x:Key="CarbonAccent" Color="#FF2D7A5A" />
    <SolidColorBrush x:Key="CarbonAccentDim" Color="#FF1F5E46" />
    <SolidColorBrush x:Key="CarbonAccentFill" Color="#662D7A5A" />

    <SolidColorBrush x:Key="CarbonText" Color="#FFE6E1E5" />
    <SolidColorBrush x:Key="CarbonMuted" Color="#FFCAC4D0" />
    <SolidColorBrush x:Key="CarbonSubtle" Color="#FF938F99" />

    <!-- 70% #1E1E1E glass fill. Window DWM/Acrylic supplies the blur behind it. -->
    <SolidColorBrush x:Key="CarbonGlassCard" Color="#B31E1E1E" />

    <SolidColorBrush x:Key="CarbonGlassCardBorder" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="MaterialToolbar" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="MaterialStatusBar" Color="#FF1C1C1C" />

</ResourceDictionary>
